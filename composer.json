{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.4",
        "laravel/framework": "^8.83.29",
        "laravel/tinker": "^2.5"
    },
    "require-dev": {
        "facade/ignition": "^2.17",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^5.10",
        "phpunit/phpunit": "^9.5.10"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-d5tc-s1qs-h781": {
                        "reason": "XSS na página de debug: só com APP_DEBUG=true, desligado em produção; o L8 usa o Ignition, não a página afetada",
                        "on-audit": false
                    },
                    "PKSA-m5cs-t1y6-qpcs": {
                        "reason": "URL assinada temporária do disco local: o site não usa URLs assinadas nem temporaryUrl",
                        "on-audit": false
                    },
                    "PKSA-3r5d-mb8f-1qw9": {
                        "reason": "CRLF na regra email: o site só envia para endereço fixo; o e-mail do usuário vai apenas no corpo, e o L8 usa SwiftMailer, não Symfony Mailer",
                        "on-audit": false
                    },
                    "PKSA-8qx3-n5y5-vvnd": {
                        "reason": "Bypass da validação de arquivos (CVE-2025-27515): o site não tem upload",
                        "on-audit": false
                    },
                    "PKSA-w9tt-7782-78jx": {
                        "reason": "Flysystem (CVE-2026-102601, baixa): bypass da checagem de caracteres de controle em caminhos; o site não manipula arquivos com caminho vindo do usuário",
                        "on-audit": false
                    }
                }
            }
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
